{
  "XCSH_CSD_DEPLOYMENT_MODE": {
    "type": "text",
    "default": "api",
    "description": "Exclusive resource ownership mode: api or terraform. Choose one ownership mode. Never run the API create/update/delete workflow against resources present in Terraform state.",
    "credential": false,
    "scope": "csd-deployment-mode"
  },
  "XCSH_API_URL": {
    "type": "text",
    "default": "https://example-corp.console.ves.volterra.io",
    "description": "XC Console API URL",
    "credential": false,
    "scope": "tenant-api"
  },
  "XCSH_API_TOKEN": {
    "type": "text",
    "default": "<XCSH_API_TOKEN>",
    "description": "XC API token",
    "credential": true,
    "scope": "api-token"
  },
  "XCSH_EMAIL": {
    "type": "text",
    "default": "user@example.com",
    "description": "CSD notification email",
    "credential": false,
    "scope": "email"
  },
  "XCSH_NAMESPACE": {
    "type": "text",
    "default": "demo-app",
    "description": "XC namespace",
    "credential": false,
    "scope": "namespace"
  },
  "XCSH_LB_NAME": {
    "type": "text",
    "default": "demo-app",
    "description": "Load balancer configuration name",
    "credential": false,
    "scope": "load-balancer"
  },
  "XCSH_DOMAINNAME": {
    "type": "text",
    "default": "app.example.com",
    "description": "Application HTTPS hostname",
    "credential": false,
    "scope": "application-hostname"
  },
  "XCSH_ROOT_DOMAIN": {
    "type": "text",
    "default": "example.com",
    "description": "Application root domain for CSD",
    "credential": false,
    "scope": "application-root-domain"
  },
  "XCSH_ORIGIN_KIND": {
    "type": "text",
    "default": "public_name",
    "description": "Selects exactly one origin representation: public_name uses XCSH_ORIGIN_HOSTNAME; public_ip uses XCSH_ORIGIN_IP",
    "credential": false,
    "scope": "origin-kind"
  },
  "XCSH_ORIGIN_HOSTNAME": {
    "type": "text",
    "default": "origin.example.com",
    "description": "Origin DNS hostname used only when XCSH_ORIGIN_KIND is public_name",
    "credential": false,
    "scope": "origin-hostname"
  },
  "XCSH_ORIGIN_IP": {
    "type": "text",
    "default": "198.51.100.10",
    "description": "Configured origin public IPv4 address",
    "credential": false,
    "scope": "origin-ip"
  },
  "XCSH_APPLICATION_MARKER": {
    "type": "text",
    "default": "OWASP Juice Shop",
    "description": "Required application/scenario content marker, independent of origin representation. Non-reference API and Azure scenarios must set a stable, deployment-specific value.",
    "credential": false,
    "scope": "application-marker"
  },
  "XCSH_ORIGIN_PORT": {
    "type": "number",
    "default": "80",
    "description": "Origin server port; must be an integer from 1 through 65535",
    "credential": false,
    "scope": "origin-port"
  },
  "XCSH_HC_NAME": {
    "type": "text",
    "default": "demo-app-health",
    "description": "Health check name",
    "credential": false,
    "scope": "healthcheck"
  },
  "XCSH_DNS_ZONE": {
    "type": "text",
    "default": "example.com",
    "description": "Delegated DNS zone",
    "credential": false,
    "scope": "dns-zone"
  },
  "XCSH_DC_NAME": {
    "type": "text",
    "default": "DC1",
    "description": "Customer data center name",
    "credential": false,
    "scope": "dc-name"
  },
  "XCSH_CENTER_1": {
    "type": "dropdown",
    "default": "US West (SJC)",
    "description": "Primary F5 XC DDoS scrubbing center",
    "credential": false,
    "scope": "center-1",
    "options": [
      "US West (SJC)",
      "US East (DCA)",
      "Toronto (YYZ)",
      "UK (LON)",
      "Germany (FRA)",
      "Paris (CDG)",
      "Asia (SIN)",
      "Bahrain (BAH)",
      "Hong Kong (HKG)",
      "Montreal (YUL)",
      "Mumbai (BOM)",
      "Ohio (CMH)",
      "Sao Paulo (GRU)",
      "Sydney (SYD)",
      "Tokyo (TYO)"
    ]
  },
  "XCSH_CENTER_2": {
    "type": "dropdown",
    "default": "US East (DCA)",
    "description": "Secondary F5 XC DDoS scrubbing center",
    "credential": false,
    "scope": "center-2",
    "options": [
      "US West (SJC)",
      "US East (DCA)",
      "Toronto (YYZ)",
      "UK (LON)",
      "Germany (FRA)",
      "Paris (CDG)",
      "Asia (SIN)",
      "Bahrain (BAH)",
      "Hong Kong (HKG)",
      "Montreal (YUL)",
      "Mumbai (BOM)",
      "Ohio (CMH)",
      "Sao Paulo (GRU)",
      "Sydney (SYD)",
      "Tokyo (TYO)"
    ]
  },
