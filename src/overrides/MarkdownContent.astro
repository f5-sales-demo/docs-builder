---
import ThemeMarkdownContent from '@f5-sales-demo/docs-theme/components/MarkdownContent.astro';
import PlaceholderFormWrapper from '../components/PlaceholderFormWrapper.astro';
---

<PlaceholderFormWrapper />
<ThemeMarkdownContent><slot /></ThemeMarkdownContent>

<script>
  import { configureCertificateReadingBand, configureCertificateFragmentSelection, createCertificateBookmarkTracker, restoreCertificateOverview, restoreCertificateReadingPosition, selectCertificateFragmentAfterLayout } from '../lib/certificate-toc.mjs';
  const bookmarkTracker = createCertificateBookmarkTracker();
  const prepareReaderScroll = () => bookmarkTracker.prepareScroll();
  window.addEventListener("scroll", () => {
    const refresh = bookmarkTracker.observeScroll();
    if (refresh && import.meta.env.F5_DOCS_REPOSITORY === "f5-sales-demo/certificate-management") {
      restoreCertificateReadingPosition(
        import.meta.env.F5_DOCS_REPOSITORY,
        document.querySelectorAll('starlight-toc, mobile-starlight-toc'),
        (id) => document.getElementById(id)?.getBoundingClientRect(),
      );
      window.dispatchEvent(new Event("resize"));
    }
  }, { passive: true });
  window.addEventListener("wheel", () => {
    prepareReaderScroll();
    requestAnimationFrame(() => requestAnimationFrame(() => bookmarkTracker.clearIntent()));
  }, { passive: true });
  window.addEventListener("touchmove", prepareReaderScroll, { passive: true });
  window.addEventListener("touchend", () => bookmarkTracker.clearIntent(), { passive: true });
  window.addEventListener("pointerdown", prepareReaderScroll, { passive: true });
  window.addEventListener("pointerup", () => bookmarkTracker.clearIntent(), { passive: true });
  window.addEventListener("keydown", (event) => {
    if (event.target instanceof Element && event.target.closest('input, textarea, select, [contenteditable="true"]')) return;
    if (["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End", "Tab", " "].includes(event.key)) prepareReaderScroll();
  });
  window.addEventListener("keyup", () => bookmarkTracker.clearIntent());
  const restoreOverview = () => restoreCertificateOverview(
    import.meta.env.F5_DOCS_REPOSITORY,
    window.scrollY,
    document.querySelectorAll('starlight-toc, mobile-starlight-toc'),
  );
  window.addEventListener('scroll', restoreOverview, { passive: true });
  const selectFragment = () => !bookmarkTracker.hasReaderScrolled() && selectCertificateFragmentAfterLayout(
    import.meta.env.F5_DOCS_REPOSITORY,
    location.hash,
    document.querySelectorAll("starlight-toc, mobile-starlight-toc"),
    (id) => {
      const target = document.getElementById(id);
      if (!target) return false;
      const bounds = target.getBoundingClientRect();
      return bounds.bottom > 0 && bounds.top < innerHeight;
    },
    async () => {
      await Promise.all([
        document.fonts.ready,
        new Promise<void>((resolve) => {
          if (document.readyState === "complete") resolve();
          else window.addEventListener("load", () => resolve(), { once: true });
        }),
      ]);
      await new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
    },
  );
  const beginBookmark = () => { bookmarkTracker.beginNavigation(); selectFragment(); };
  window.addEventListener("hashchange", beginBookmark);
  window.addEventListener("pageshow", beginBookmark);
  let breadcrumbObserver;
  const configureReadingBand = () => {
    bookmarkTracker.beginNavigation();
    const breadcrumb = document.querySelector(".breadcrumbs[data-certificate-management]");
    if (!breadcrumb) return;
    configureCertificateFragmentSelection(
      import.meta.env.F5_DOCS_REPOSITORY,
      document.querySelectorAll("starlight-toc, mobile-starlight-toc"),
      (component) => {
        let id;
        try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
        const bounds = document.getElementById(id)?.getBoundingClientRect();
        if (!bounds) return;
        return {
          hash: location.hash,
          readerScrolled: bookmarkTracker.hasReaderScrolled(),
          top: bounds.top,
          bottom: bounds.bottom,
          height: innerHeight,
          scrollY: window.scrollY,
          maxScroll: Math.max(0, document.documentElement.scrollHeight - innerHeight),
          readingTop: -parseFloat(component.getRootMargin()),
        };
      },
    );
    configureCertificateReadingBand(
      import.meta.env.F5_DOCS_REPOSITORY,
      document.querySelectorAll("starlight-toc, mobile-starlight-toc"),
      () => document.querySelector(".breadcrumbs[data-certificate-management]")?.getBoundingClientRect().height || 0,
    );
    breadcrumbObserver?.disconnect();
    let previousHeight;
    breadcrumbObserver = new ResizeObserver(() => {
      const height = breadcrumb.getBoundingClientRect().height;
      if (height === previousHeight) return;
      previousHeight = height;
      // Recreate native intersections using their existing resize lifecycle.
      window.dispatchEvent(new Event("resize"));
      selectFragment();
    });
    breadcrumbObserver.observe(breadcrumb);
    restoreOverview();
    selectFragment();
  };
  const prepareToc = () => Promise.all([
    customElements.whenDefined("starlight-toc"),
    customElements.whenDefined("mobile-starlight-toc"),
  ]).then(configureReadingBand);
  prepareToc();
  document.addEventListener("astro:page-load", prepareToc);

</script>
